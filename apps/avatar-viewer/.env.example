# Copy to .env and fill in what you have. Every key is optional:
# without them you get heuristic scene choice and empty scenes (no 3D person).

# --- Claude: reads the photo + profile text and picks scene, lighting, props ---
ANTHROPIC_API_KEY=

# --- 3D recreation of the person ---
# fal.ai runs both stages: headshot -> full-length photo (FLUX Kontext) -> 3D mesh.
FAL_KEY=
FAL_REFERENCE_MODEL=fal-ai/flux-pro/kontext
# Mesh model on fal. fal-ai/trellis also works.
FAL_MODEL=fal-ai/hunyuan3d/v2
# Optional: use Meshy (https://www.meshy.ai) for the mesh stage instead.
MESHY_API_KEY=

# --- Sign In with LinkedIn using OpenID Connect ---
# Create an app at https://www.linkedin.com/developers/apps, add the
# "Sign In with LinkedIn using OpenID Connect" product, and register the redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3010/api/auth/linkedin/callback

# Where the browser app lives (used for post-login redirect)
APP_ORIGIN=http://localhost:3010
API_PORT=3011
