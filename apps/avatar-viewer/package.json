{
	"name": "avatar-viewer",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host --port 3010\"",
		"dev:web": "vite --host --port 3010",
		"dev:api": "tsx watch server/index.ts",
		"start": "tsx server/index.ts",
		"build": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
		"preview": "vite preview",
		"format": "prettier --write --ignore-path=../../.prettierignore ."
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.128.0",
		"three": "^0.186.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "24.0.13",
		"@types/three": "^0.186.0",
		"concurrently": "^10.0.5",
		"svelte": "5.20.5",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"vite": "6.2.0"
	}
}
